# テキストファイルを自動判定し、リポジトリ内ではLFに正規化する
* text=auto

# 常にLFで取り扱うテキストファイル
*.txt        text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.jsonc      text eol=lf
*.js         text eol=lf
*.ts         text eol=lf
*.py         text eol=lf
*.go         text eol=lf
*.mod        text eol=lf
*.sum        text eol=lf
*.sh         text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.toml       text eol=lf
*.xml        text eol=lf
*.csv        text eol=lf

# Windows固有ファイルはCRLFで取り扱う
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# バイナリファイルとして取り扱う
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.exe        binary
*.dll        binary
*.xlsx       binary
*.xls        binary
*.docx       binary
*.pptx       binary
